require_linear_history          = false

# Clerk has no Terraform provider — run `clerk init` in the new repo first,
# then paste the dev-instance keys it gives you here.
clerk_publishable_key        = null
clerk_secret_key             = null
clerk_webhook_signing_secret = null

# Leave null until a Clerk production instance exists for this app.
clerk_production_publishable_key        = null
clerk_production_secret_key             = null
clerk_production_webhook_signing_secret = null
